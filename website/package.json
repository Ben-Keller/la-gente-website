{
  "name": "la-gente-de-la-tierra",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "ASTRO_TELEMETRY_DISABLED=1 astro dev --host 127.0.0.1",
    "build": "node scripts/prepare-cms.mjs && CMS_SNAPSHOT=.cms/content.json ASTRO_TELEMETRY_DISABLED=1 astro build && CMS_SNAPSHOT=.cms/content.json node scripts/apply-cms-pages.mjs && node scripts/validate-pages.mjs && CMS_SNAPSHOT=.cms/content.json node scripts/validate-cms.mjs",
    "validate:pages": "node scripts/validate-pages.mjs",
    "preview": "ASTRO_TELEMETRY_DISABLED=1 astro preview --host 127.0.0.1"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@portabletext/to-html": "6.0.0",
    "@sanity/client": "8.6.2",
    "@sanity/image-url": "2.1.1",
    "astro": "7.1.3",
    "cheerio": "1.2.0",
    "d3": "^7.9.0",
    "groq": "6.14.1",
    "photoswipe": "^5.4.4",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0"
  }
}
