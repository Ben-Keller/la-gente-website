---
import { withBase } from '../utils/paths';
import NewsletterForm from './NewsletterForm.astro';
import { footerNavigation, SITE, socialLinks } from '../data/site';
---
<footer class="site-footer">
  <div>
    <p class="footer-mark">{SITE.name}</p>
    <p>{SITE.description}</p>
    <p class="footer-production">A production of {SITE.productionCompany}</p>
  </div>
  <nav class="footer-links" aria-label="Footer navigation">
    {footerNavigation.map(({ label, href }) => <a href={withBase(href)}>{label}</a>)}
  </nav>
  <div class="footer-newsletter">
    <p class="eyebrow">Screening and release updates</p>
    <NewsletterForm compact />
  </div>
  <div class="footer-social">
    {socialLinks.map(({ label, href }) => (
      <a href={href} target={href.startsWith('http') ? '_blank' : undefined} rel={href.startsWith('http') ? 'noreferrer' : undefined}>{label}</a>
    ))}
  </div>
  <p class="footer-meta">© {new Date().getFullYear()} {SITE.name} · {SITE.productionCompany} · All rights reserved.</p>
</footer>
