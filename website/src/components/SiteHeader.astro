---
import { withBase } from '../utils/paths';
import HeaderContents from './HeaderContents.astro';
const pathname = Astro.url.pathname;
const isHome = pathname === withBase('/');
---
<header class:list={['site-header', isHome && 'site-header--hero']}>
  <HeaderContents navigationId="primary-navigation" pathname={pathname} />
</header>
{isHome && (
  <header class="site-header site-header--drop" aria-hidden="true" inert>
    <HeaderContents navigationId="sticky-primary-navigation" pathname={pathname} sticky />
  </header>
)}
<script>
  import { initializeSiteHeader } from '../scripts/siteHeader';
  initializeSiteHeader();
</script>
