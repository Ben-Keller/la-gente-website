---
import BaseLayout from './BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import type { Chapter } from '../data/chapters';
import { withBase } from '../utils/paths';
import {cms, rich} from '../data/cms.mjs';
const { chapter } = Astro.props as { chapter: Chapter };
const story = cms.chapters.find(item => item.number === chapter.number);
---
<BaseLayout title={`${chapter.title} — La Gente de La Tierra`} description={chapter.summary}>
  <section class="chapter-hero page-shell">
    <p class="eyebrow">Chapter {String(chapter.number).padStart(2, '0')} · {chapter.region} · Elevation {chapter.elevation}</p>
    <h1>{chapter.title}</h1>
    <p class="chapter-deck">{chapter.community}</p>
    <PlaceholderImage src={chapter.images.hero} label={`${chapter.title} hero still`} ratio="cinema" eager />
  </section>
  <section class="chapter-intro page-shell narrow-grid">
    <div><p class="eyebrow">The story</p><h2>{chapter.eyebrow}</h2></div>
    <div><p class="lead">{chapter.summary}</p><div set:html={rich(story.story)} /><ul class="tag-list">{chapter.themes.map((theme) => <li>{theme}</li>)}</ul></div>
  </section>
  <section class="chapter-details page-shell">
    <article><p class="eyebrow">Location</p><h2>{chapter.location}</h2><p>{chapter.locationDescription}</p></article>
    <article><p class="eyebrow">Environmental focus</p><h2>Land, climate, and continuity</h2><p>{chapter.environmentalFocus}</p></article>
    <article><p class="eyebrow">In this chapter</p><h2>A closer look</h2><p>{chapter.productionNote}</p></article>
  </section>
  <section class="image-pair page-shell">
    <PlaceholderImage src={chapter.images.portrait} label={`${chapter.title} — photograph from the series`} ratio="portrait" />
    <PlaceholderImage src={chapter.images.landscape} label={chapter.number === 6 ? 'Archaeological ruins on Peru’s northern coast' : `${chapter.title} — landscape from the series`} ratio="landscape" />
  </section>
  <section class="chapter-watch page-shell">
    <div class="youtube-placeholder">
      <span>The documentary series</span><strong>{cms.settings.releaseLabel}</strong><p>Get a first look at the six-part journey across Peru.</p><a class="button" href={withBase('/#trailer')}>Watch the trailer</a>
    </div>
    <div><p class="eyebrow">Continue the story</p><h2>Support work connected to this place.</h2><p>Learn more about an organization related to the themes and geography of this chapter.</p><a class="button" href={chapter.relatedOrganizationUrl} target="_blank" rel="noreferrer">Visit {chapter.relatedOrganization}</a></div>
  </section>
  <nav class="chapter-next page-shell" aria-label="Chapter navigation">
    <a href={withBase('/communities/')}><span>All stories</span><strong>Explore the communities</strong></a>
  </nav>
</BaseLayout>
