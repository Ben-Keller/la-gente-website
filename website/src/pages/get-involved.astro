---
import BaseLayout from '../layouts/BaseLayout.astro';
import InvolvementMap from '../components/InvolvementMap.astro';
import OrganizationAccordion from '../components/OrganizationAccordion.astro';
import { organizations } from '../data/organizations';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Get Involved — La Gente de La Tierra" description="Support community organizations working in the places featured by La Gente de La Tierra.">
  <InvolvementMap organizations={organizations} />

  <section class="page-shell organization-accordions" aria-label="Community organizations">
    <div class="organization-accordions__intro">
      <div>
        <p class="eyebrow">Organizations</p>
        <h2>Meet the people doing the work.</h2>
      </div>
      <p>Explore each entry to learn more and find ways to get involved.</p>
    </div>
    {organizations.map((organization, index) => (
      <OrganizationAccordion organization={organization} index={index} />
    ))}
  </section>

  <aside class="page-shell editorial-note organization-invitation">
    <div>
      <p class="eyebrow">Join the page</p>
      <h2>Does your organization work alongside communities in Peru?</h2>
      <p>We welcome organizations advancing ecological conservation, cultural continuity, community health, education, or locally led development to introduce their work for possible inclusion on this page.</p>
    </div>
    <a class="button" href={withBase('/contact-us/')}>Contact the team</a>
  </aside>

  <script>
    import { initializeInvolvementAccordions } from '../scripts/involvementAccordions';
    import { initializeInvolvementMap } from '../scripts/involvementMap';

    initializeInvolvementAccordions();
    initializeInvolvementMap();
  </script>
</BaseLayout>
