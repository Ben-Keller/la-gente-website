---
import BaseLayout from '../layouts/BaseLayout.astro';
import { withBase } from '../utils/paths';
---
<BaseLayout title="Page not found — La Gente de La Tierra" description="The requested page could not be found.">
  <section class="not-found">
    <img src={withBase('/images/recovered/main5.webp')} alt="" />
    <div class="not-found__shade"></div>
    <div class="not-found__content page-shell">
      <p class="eyebrow">404 · Page not found</p>
      <h1>Take another<br />path.</h1>
      <p class="lead">The page may have moved, but the journey continues across six communities and landscapes.</p>
      <div><a class="button" href={withBase('/')}>Return home</a><a class="text-link" href={withBase('/communities/')}>Explore the chapters</a><a class="text-link" href={withBase('/media/')}>View media</a></div>
    </div>
  </section>
</BaseLayout>
