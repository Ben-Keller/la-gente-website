---
import BaseLayout from '../layouts/BaseLayout.astro';
import PlaceholderImage from '../components/PlaceholderImage.astro';
import { withBase } from '../utils/paths';
import sharp from 'sharp';
import path from 'node:path';
import { galleryIds, galleryCaptions } from '../data/gallery';

const galleryImages = await Promise.all(galleryIds.map(async (id, index) => {
  const src = `/images/gallery/${id}.webp`;
  const metadata = await sharp(path.join(process.cwd(), 'public', src)).metadata();

  return {
    src,
    width: metadata.width ?? 1600,
    height: metadata.height ?? 1200,
    caption: galleryCaptions[id] ?? '',
    alt: galleryCaptions[id] ?? `Photograph ${index + 1} from filming La Gente de La Tierra in Peru`,
  };
}));
---
<BaseLayout title="Media — La Gente de La Tierra" description="Press, trailers, stills, and updates from La Gente de La Tierra.">
  <header class="media-hero page-shell"><p class="eyebrow">Press & media</p><h1>Media</h1><p>Trailers, production stills, press materials, and release updates.</p></header>
  <section class="page-shell media-grid">
    <article>
      <div class="media-trailer"><video controls playsinline preload="metadata" poster={withBase('/images/gallery/media23.webp')}><source src={withBase('/video/trailer-vertical.mp4')} type="video/mp4" /></video></div>
      <p class="eyebrow">Film</p><h2>Official trailer</h2><p>Watch an introduction to the six-part documentary journey.</p>
    </article>
    <article>
      <PlaceholderImage src="/images/recovered/media23.webp" label="Press still collection" ratio="landscape" />
      <p class="eyebrow">Press kit</p><h2>Stills & materials</h2><p>Synopsis, filmmaker biographies, production credits, and selected photography.</p>
      <a class="button" href={withBase('/press-kit/')}>Open press kit</a>
    </article>
  </section>
  <section class="page-shell recovered-gallery" aria-labelledby="gallery-title">
    <h2 id="gallery-title" class="sr-only">Photograph gallery</h2>
    <ul class="gallery-grid" id="media-gallery">
      {galleryImages.map((image, index) => (
        <li style={`--photo-ratio:${image.width}/${image.height}`}>
          <a
            href={withBase(image.src)}
            data-pswp-width={image.width}
            data-pswp-height={image.height}
            data-caption={image.caption}
            target="_blank"
            aria-label={`Open photograph ${index + 1} of ${galleryImages.length}`}
          >
            <img
              src={withBase(image.src)}
              alt={image.alt}
              width={image.width}
              height={image.height}
              loading={index < 4 ? 'eager' : 'lazy'}
              fetchpriority={index < 2 ? 'high' : 'auto'}
              decoding="async"
            />
          </a>
        </li>
      ))}
    </ul>
  </section>

  <script>
    import PhotoSwipeLightbox from 'photoswipe/lightbox';
    import 'photoswipe/style.css';

    const lightbox = new PhotoSwipeLightbox({
      gallery: '#media-gallery',
      children: 'a',
      pswpModule: () => import('photoswipe'),
      bgOpacity: 0.94,
      showHideAnimationType: 'fade',
    });

    lightbox.on('uiRegister', () => {
      lightbox.pswp?.ui?.registerElement({
        name: 'field-caption',
        order: 9,
        isButton: false,
        appendTo: 'root',
        onInit: (element, pswp) => {
          element.setAttribute('aria-live', 'polite');
          pswp.on('change', () => {
            const caption = pswp.currSlide?.data.element?.getAttribute('data-caption') ?? '';
            element.textContent = caption;
            element.hidden = !caption;
          });
        },
      });
    });
    lightbox.init();
  </script>
  <style is:global>
    .pswp__field-caption {
      position: absolute;
      bottom: max(16px, env(safe-area-inset-bottom));
      left: 50%;
      transform: translateX(-50%);
      width: max-content;
      max-width: min(720px, calc(100% - 32px));
      max-height: 25vh;
      overflow: auto;
      box-sizing: border-box;
      padding: 10px 16px;
      border-radius: 4px;
      background: rgb(0 0 0 / 78%);
      color: #fff;
      font-family: 'Open Sans', sans-serif;
      font-size: 14px;
      line-height: 1.5;
      text-align: center;
    }
  </style>
</BaseLayout>
