---
import BaseLayout from '../layouts/BaseLayout.astro';
import NewsletterForm from '../components/NewsletterForm.astro';
---
<BaseLayout title="Watch & Release — La Gente de La Tierra" description="Release, screening, and viewing information for La Gente de La Tierra.">
  <header class="page-hero page-shell">
    <p class="eyebrow">Watch & release</p>
    <h1>Follow the<br />journey to screen.</h1>
    <p class="lead">La Gente de La Tierra is planned as a six-part YouTube documentary series. Final release dates and viewing links will be announced here.</p>
  </header>
  <section class="watch-grid page-shell">
    <div class="youtube-placeholder youtube-placeholder--large" role="img" aria-label="YouTube series player placeholder">
      <span>Official series</span><strong>YouTube placeholder</strong><small>Viewing link forthcoming</small>
    </div>
    <div class="release-card">
      <p class="eyebrow">Current status</p>
      <h2>Release details are being finalized.</h2>
      <dl>
        <div><dt>Format</dt><dd>Six-part documentary series</dd></div>
        <div><dt>Platform</dt><dd>YouTube · placeholder</dd></div>
        <div><dt>Release</dt><dd>Date pending confirmation</dd></div>
        <div><dt>Screenings</dt><dd>Festival and community dates forthcoming</dd></div>
      </dl>
    </div>
  </section>
  <section class="newsletter-section page-shell">
    <p class="eyebrow">Stay with the story</p>
    <h2>Receive screening and release updates.</h2>
    <NewsletterForm />
  </section>
</BaseLayout>
